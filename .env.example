# Supabase Postgres (shared pooler) — percent-encode special characters in the password (e.g. @ → %40)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-1-eu-west-1.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require

# Supabase API (client-side / REST)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx
# Server-only — never expose in frontend code
SUPABASE_SERVICE_ROLE_KEY=your_service_role_jwt_here
PORT=3001

# Resend — transactional email (resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Once you verify a domain in Resend, set this to e.g. "Legend Engineers <noreply@legendengineers.co.za>"
# Leave unset to use the Resend test address (only delivers to your own inbox)
EMAIL_FROM=Legend Engineers <noreply@yourdomain.com>

# Optional — AI chat widget
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx

# Admin dashboard (/admin) — required for admin login to work at all
# Generate a secret with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_JWT_SECRET=replace_with_a_random_64_char_hex_string
# The first admin account is auto-created on first login attempt using these two vars
# (only while the admin_users table is empty — change the password from Admin > Account afterwards)
ADMIN_EMAIL=owner@yourdomain.com
ADMIN_PASSWORD=ReplaceWithAStrongPassword
